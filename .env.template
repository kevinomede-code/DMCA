# THESIS AUTORESEARCH — API KEYS
# Rinomina questo file in .env e inserisci le chiavi reali
# Aggiungi .env al .gitignore — non committare mai questo file

# HuggingFace (per scaricare modelli e dataset)
# Ottieni su: https://huggingface.co/settings/tokens
HF_TOKEN=hf_inserisci_qui

# Semantic Scholar (opzionale — senza key: 100 req/5min)
# Ottieni su: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Anthropic (per autoresearch con Claude API in Fase 1)
# Ottieni su: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-inserisci_qui

# Percorsi progetto
PROJECT_ROOT=./
RESULTS_DIR=./results
DATA_DIR=./data
REFERENCES_DIR=./data/references
